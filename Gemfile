source "https://rubygems.org"

# GitHub Pages builds the live site with its own pinned gems and ignores this
# file. This is only for local previews, so it lists just what the site uses
# instead of the github-pages meta-gem (which pulls in ~100 gems).
gem "jekyll", "~> 3.10"
gem "jekyll-paginate"
gem "jekyll-optional-front-matter"
gem "jekyll-relative-links"
gem "kramdown-parser-gfm"
gem "webrick"

# No longer bundled with Ruby from 3.4 on
gem "base64"
gem "bigdecimal"

# Windows has no system timezone database
gem "tzinfo-data", platforms: [:windows, :jruby]
